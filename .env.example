# =============================================================================
# OpenGrow — Environment Configuration
# =============================================================================
# NO ACTUAL SECRETS IN THIS FILE. Real values are fetched at runtime from
# Infisical. This file lists ONLY the variables required to reach Infisical
# and identify the service (12-factor).
#
# For local bootstrap, run: make bootstrap
# =============================================================================

# ---- Infisical (secrets manager) ----
INFISICAL_URL=http://infisical:8080
INFISICAL_PROJECT_ID=opengrow-dev
INFISICAL_ENVIRONMENT=dev
INFISICAL_TOKEN=                          # set by make bootstrap

# ---- Deployment mode ----
# Values: dev | staging | prod
OPENGROW_ENV=dev
HOSTED_MODE=false                         # true only on opengrow.dev cluster

# ---- Ports (host-side; override in compose files) ----
NODE_GATEWAY_PORT=3001
FASTAPI_CORE_PORT=8000
FLOWER_PORT=5555
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
MAILPIT_UI_PORT=8025

# ---- Service discovery (internal hostnames — never localhost) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opengrow
POSTGRES_USER=opengrow
# POSTGRES_PASSWORD — from Infisical

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD — from Infisical
REDIS_BROKER_DB=0
REDIS_RESULT_DB=1
REDIS_CACHE_DB=2

QDRANT_HOST=qdrant
QDRANT_PORT=6333

MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET_ASSETS=opengrow-assets
MINIO_BUCKET_TEMP=opengrow-temp
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD — from Infisical

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

OPENFGA_API_URL=http://openfga:8080
# OPENFGA_STORE_ID / OPENFGA_MODEL_ID — from Infisical (set post-bootstrap)

LITELLM_URL=http://litellm:4000
# LITELLM_MASTER_KEY — from Infisical
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET / GOOGLE_OAUTH_REDIRECT_URI — from Infisical

MAILPIT_HOST=mailpit
MAILPIT_SMTP_PORT=1025

# ---- Prod-only ----
CADDY_DOMAIN=opengrow.dev
CADDY_EMAIL=admin@your-domain.example
