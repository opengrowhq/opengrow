# Prod — TLS auto-issued by Caddy via Let's Encrypt.
{
	email {$CADDY_EMAIL}
	# ACME auto-provisioning; remove `staging=false` line if using LE staging.
}

{$CADDY_DOMAIN} {
	encode gzip zstd

	# API traffic to node-gateway (BFF). The gateway proxies bare namespaces
	# 1:1 to fastapi-core (/auth, /assets, /content, …), so the /api prefix is
	# stripped here; /auth/* already matches the gateway's bare paths.
	@api path /auth/* /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy node-gateway:3001
	}

	# Everything else — Next.js frontend
	reverse_proxy frontend:3000

	log {
		output stdout
		format json
	}
}

# Flower behind basic auth (edit via infisical + basicauth directive later)
flower.{$CADDY_DOMAIN} {
	reverse_proxy flower:5555
}
