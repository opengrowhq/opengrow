# Prod — TLS auto-issued by Caddy via Let's Encrypt.
{
	email {$CADDY_EMAIL}
	# ACME auto-provisioning; remove `staging=false` line if using LE staging.
}

{$CADDY_DOMAIN} {
	encode gzip zstd

	# API traffic to node-gateway (BFF). The frontend calls bare namespaces
	# (same-origin, no /api prefix — see services/frontend/src/lib/http.ts),
	# and the gateway proxies those bare paths 1:1 to fastapi-core, so Caddy
	# must match them directly here rather than stripping an /api prefix that
	# the frontend never sends. Keep in sync with node-gateway's
	# PROXIED_PREFIXES (services/node-gateway/src/public-paths.ts).
	@api path /auth/* /assets/* /generations/* /content/* /brands/* /analytics/* /invites/* /playbooks/* /orchestrator/* /billing/*
	handle @api {
		reverse_proxy node-gateway:3001
	}

	# Everything else — Next.js frontend
	reverse_proxy frontend:3000

	log {
		output stdout
		format json
	}
}

# Flower behind basic auth (edit via infisical + basicauth directive later)
flower.{$CADDY_DOMAIN} {
	reverse_proxy flower:5555
}
