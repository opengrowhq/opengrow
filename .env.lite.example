# =============================================================================
# OpenGrow Lite — Personal / Single-tenant deployment
# =============================================================================
# Copy to .env then edit the values below. All secrets are in env vars (no
# Infisical, no vault). Appropriate for personal use only.
#
# For multi-user / multi-tenant / production, use the base docker-compose.yml
# with Infisical + OpenFGA (see .env.example).
# =============================================================================

# ---- Postgres ----
POSTGRES_DB=opengrow
POSTGRES_USER=opengrow
POSTGRES_PASSWORD=CHANGE-ME-generate-a-random-string

# ---- MinIO (object storage) ----
MINIO_ACCESS_KEY=opengrow
MINIO_SECRET_KEY=CHANGE-ME-generate-a-random-string

# ---- JWT signing key ----
JWT_SECRET=CHANGE-ME-32-random-chars-minimum

# ---- BYOK LLM keys (set at least one; leave others blank) ----
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Ollama (local, free) — runs as the in-stack `ollama` service by default.
# Pull a model with:  docker compose -f docker-compose.lite.yml exec ollama ollama pull llama3.1
# To use Ollama on your HOST instead, set http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://ollama:11434

# Default model for generation + Brand DNA (used when a request omits one).
# Free/local default: ollama/llama3.1 (needs the model pulled — see above).
# Model strings must be LiteLLM-resolvable — bare OpenAI names work
# (LiteLLM defaults unprefixed names to OpenAI), but other providers need
# their provider prefix or LiteLLM can't route the call OR price it:
# OpenAI (needs OPENAI_API_KEY): gpt-5-mini | gpt-4.1-mini
# Anthropic (needs ANTHROPIC_API_KEY): claude-sonnet-4-5
# Google (needs GOOGLE_API_KEY): gemini/gemini-flash-latest
DEFAULT_LLM_MODEL=ollama/llama3.1

# Embedding model (brand-asset uploads). Defaults to a free local Ollama model
# in lite mode — pull it once with:
#   docker compose -f docker-compose.lite.yml exec ollama ollama pull nomic-embed-text
# To use a hosted provider instead (needs the matching API key above), set e.g.:
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL=

# ---- GitHub PR publishing (optional, BYOK) ----
# Fine-grained or classic PAT with Contents + Pull requests write on your target repo.
# Leave blank to disable GitHub publishing.
GITHUB_TOKEN=

# ---- Google analytics/search connectors (optional) ----
# OAuth client for GA4/GSC read-only connector setup. Leave blank to disable.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/analytics/connectors/google/callback

# ---- Stripe billing (optional, hosted only — Pro/Team paid tiers) ----
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Set after registering a webhook endpoint (or via `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=
# Set after creating Products/Prices — see services/fastapi-core/scripts/stripe_setup.py
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=
# Checkout/Billing Portal redirect target — must match where the frontend is served.
FRONTEND_BASE_URL=http://localhost:3000

# ---- Frontend ----
# Host port the Next.js frontend is published on.
HOST_FRONTEND_PORT=3000
# Base URL the browser uses to reach the API. Must match the host-published
# fastapi-core port (HOST_FASTAPI_PORT). Default assumes 8000.
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Public origin of the app. Only used to turn the social-preview (og:image)
# URL into an absolute one, so the default is fine for local work.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
