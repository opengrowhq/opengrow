{
  "name": "@opengrow/node-gateway",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "format": "prettier -w src",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/http-proxy": "11.6.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "5.12.3",
    "jose": "6.2.6",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "find-my-way": "^9.7.0"
  }
}
